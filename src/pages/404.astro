---
import { BASE } from '../lib/urls.mjs';
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Página no encontrada | MSP Tutorials ES" description="La página que buscas no existe">
  <slot name="sidebar">
    <Sidebar currentSlug="404" />
  </slot>

  <div class="error-page">
    <h1>404</h1>
    <h2>Página no encontrada</h2>
    <p>Lo sentimos, la página que buscas no existe o ha sido movida.</p>
    <a href={BASE} class="home-link">← Volver al inicio</a>
    <a href="{BASE}/buscar/" class="search-link">Buscar tutoriales</a>
  </div>

<style>
  .error-page { text-align: center; padding: 4rem 1.5rem; max-width: 400px; margin: 0 auto; }
  .error-page h1 { font-size: 6rem; font-weight: 700; color: var(--color-primary); line-height: 1; margin-bottom: 1rem; }
  .error-page h2 { font-size: 1.5rem; margin-bottom: 1rem; }
  .error-page p { color: var(--color-text-muted); margin-bottom: 2rem; }
  .home-link, .search-link { display: inline-block; margin: 0.5rem; padding: 0.75rem 1.5rem; background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); text-decoration: none; font-weight: 500; transition: all var(--transition); }
  .home-link:hover, .search-link:hover { border-color: var(--color-primary); color: var(--color-primary); text-decoration: none; }
  @media (max-width: 640px) { .error-page h1 { font-size: 4rem; } }
</style>
</Layout>