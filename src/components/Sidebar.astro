      { title: 'Tutorial 7: Keying', slug: '17-compresion-07-keying', order: 60 },
      { title: 'Tutorial 8: Microsounds', slug: '17-compresion-08-microsounds', order: 61 },
      { title: 'Tutorial 9: Ducking', slug: '17-compresion-09-ducking', order: 62 },
